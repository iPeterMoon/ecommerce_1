<script>
    // Actualizar el link del footer segÃºn autenticaciÃ³n
    (function() {
        const token = localStorage.getItem('token') || sessionStorage.getItem('token');
        const footerAccountLink = document.getElementById('footer-account-link');
        
        if (footerAccountLink && token) {
            footerAccountLink.href = 'account.jsp';
            footerAccountLink.textContent = 'Mi Cuenta';
        }
    })();
</script>